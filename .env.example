# MySQL is the deployment database. Create an empty database with utf8mb4 first.
DATABASE_URL=mysql+pymysql://math_user:change_me@127.0.0.1:3306/adaptive_math?charset=utf8mb4
# For a zero-configuration local demo use sqlite:///./adaptive_math.db
APP_TIMEZONE=Asia/Shanghai
PASS_MASTERY=0.75
PASS_DISTINCT=5
MASTERY_WINDOW=20
DEMO_PASSWORD=DemoMath2026!
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional compose.yaml settings; use port 3307 in DATABASE_URL with Docker.
MYSQL_PASSWORD=replace_with_a_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_password

# Server only. real never silently falls back to mock.
LLM_MODE=real
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
LLM_MAX_ROUNDS=4
LLM_MAX_TOOL_CALLS=8
LLM_TOKEN_BUDGET=64000
LLM_MAX_OUTPUT_TOKENS=1600
LLM_CONTEXT_CHARS=14000
LLM_REQUEST_SECONDS=100
# Mock is explicitly test-only and requires BOTH settings; do not expose it publicly.
ALLOW_TEST_MOCK=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE=storage/models
RAG_INDEX_DIR=storage/index
RAG_MODE=vector
RAG_TOP_K=5
RAG_VECTOR_THRESHOLD=0.65
RAG_KEYWORD_THRESHOLD=0.08
RAG_CONTEXT_CHARS=5000
